<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through Google's backup or a phone-to-phone transfer: the
     database holds all the person's data, and the shared preferences hold the sign-in
     cookie for the sync server. Use "Download database" or sync to move data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
