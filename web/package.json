{
  "name": "jitterbug-web",
  "private": true,
  "version": "0.6.3",
  "type": "module",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "predev": "npm run icons",
    "dev": "vite",
    "prebuild": "npm run icons",
    "build": "tsc -b && vite build && node -e \"require('fs').closeSync(require('fs').openSync('dist/.gitkeep', 'a'))\"",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.4",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@iconify-json/fluent": "1.2.60",
    "@iconify-json/prime": "1.2.5",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-grid-layout": "1.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unicode-emoji-json": "0.9.0",
    "vite": "6.4.5",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0"
  }
}
